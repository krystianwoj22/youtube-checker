# Copy to .env and fill in. .env is gitignored — the key never enters the repo.
#   cp .env.example .env
#
# Get a key: https://console.cloud.google.com/apis/credentials
# Enable "YouTube Data API v3" for the project.
# Reuse the key from the Viral Content System if you have one.

YOUTUBE_API_KEY=

# Optional — override config/config.json without editing it
# YT_CHANNEL_ID=UCKlytYAOLYsiz6sY0zzmY4A
# COMPETITOR_CHANNEL_IDS=UCxxxx,UCyyyy
